# ---- server ----
RANKRECOVERY_HOST=0.0.0.0
RANKRECOVERY_PORT=8420
RANKRECOVERY_DATA_DIR=/data
# SQLite (default) or PostgreSQL: postgresql+psycopg://rank:secret@db:5432/rankrecovery
# RANKRECOVERY_DATABASE_URL=sqlite:////data/rankrecovery.db
RANKRECOVERY_JOB_WORKERS=2
RANKRECOVERY_LOG_LEVEL=info
# Optional bootstrap admin key (lets you call the API before any key exists in the DB).
# Prefer creating keys with `rankrecovery-admin create-key` and then removing this.
# RANKRECOVERY_ADMIN_KEY=change-me-long-random-string
# Vision extractor key (can also be entered in the desktop client settings and stored in the DB)
# ANTHROPIC_API_KEY=sk-ant-...

# ---- discord bot ----
RANKRECOVERY_BOT_DISCORD_TOKEN=
RANKRECOVERY_BOT_API_BASE_URL=http://server:8420
RANKRECOVERY_BOT_API_KEY=
# comma or JSON list of role ids allowed to submit screenshots
RANKRECOVERY_BOT_STAFF_ROLE_IDS=[]
RANKRECOVERY_BOT_ADMIN_ROLE_IDS=[]
# guild ids for instant command sync (optional)
RANKRECOVERY_BOT_GUILD_IDS=[]
