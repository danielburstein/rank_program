[Unit]
Description=Rank Recovery Discord bot
After=network-online.target rankrecovery-server.service
Wants=network-online.target

[Service]
Type=simple
User=rankrecovery
WorkingDirectory=/opt/rankrecovery
EnvironmentFile=/opt/rankrecovery/.env
ExecStart=/opt/rankrecovery/.venv/bin/rankrecovery-bot
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
