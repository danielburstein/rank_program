# Copy to the ROOT of the split server's files as ".env" (next to main.py).
# The panel's SERVER_PORT is used automatically for the API; do not set a port here.
RANKRECOVERY_DATA_DIR=data
RANKRECOVERY_LOG_LEVEL=info
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Discord bot (fill in after creating the staff API key with rankrecovery-admin;
# leave empty at first and the API starts alone)
RANKRECOVERY_BOT_DISCORD_TOKEN=
RANKRECOVERY_BOT_API_KEY=
RANKRECOVERY_BOT_GUILD_IDS=
RANKRECOVERY_BOT_STAFF_ROLE_IDS=
